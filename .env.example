# ==========================================
# 1. BẮT BUỘC NẾU BẬT NGUỒN TƯƠNG ỨNG TRONG config.yaml
# ==========================================
# Cần nếu sources.serpapi.enabled: true (lấy từ https://serpapi.com)
SERPAPI_KEY=

# Cần nếu sources.jsearch.enabled: true (lấy từ RapidAPI JSearch)
RAPIDAPI_KEY=

# Cần nếu notify.telegram.enabled: true (lấy từ @BotFather & @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# 2. TÙY CHỌN (OPTIONAL)
# ==========================================
# Cloud Database (nếu không điền sẽ tự lưu vào file data/jobs.csv)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LLM Fallback (chuẩn hóa lương, level khi regex không đọc được, miễn phí tại https://aistudio.google.com/)
GEMINI_API_KEY=
# Hoặc endpoint OpenAI-compatible:
# LLM_API_KEY=
# LLM_BASE_URL=

# Dashboard Web (mặc định hunter2026 nếu để trống)
DASHBOARD_SECRET_KEY=hunter2026
# Bật = "true" nếu muốn bỏ qua nhập mật khẩu khi chạy local:
# DASHBOARD_AUTH_DISABLED=true
